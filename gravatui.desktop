[Desktop Entry]
Type=Application
Name=Gravar tela
GenericName=Gravação de tela
Comment=TUI para o grava-tela (gpu-screen-recorder)
Exec=kitty --class gravatui -T "Gravar tela" -o initial_window_width=455 -o initial_window_height=385 -o remember_window_size=no @REPO@/gravatui.py
Icon=media-record
Terminal=false
Categories=AudioVideo;Utility;
Keywords=gravar;tela;screen;record;screencast;video;
StartupWMClass=gravatui
